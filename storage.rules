// Firebase Storage Security Rules for خزينتك (Kazena)
// Deploy with: firebase deploy --only storage:rules
//
// These rules enforce:
// - Only authenticated users can access their own files
// - File size limits for uploads
// - Content type validation

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User files directory
    match /users/{userId}/{allPaths=**} {
      // Read: only the file owner
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Write: only the file owner, with size limit (50MB)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
